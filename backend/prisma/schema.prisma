generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  EMAIL
  CALENDAR
}

enum NotificationStatus {
  PENDING
  SENT
  RETRYING
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password_hash String
  role          Role
  name          String
  google_access_token  String?
  google_refresh_token String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  doctorProfile      DoctorProfile?
  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")
  doctorLeaves       DoctorLeave[]
}

model DoctorProfile {
  id               String   @id @default(cuid())
  user_id          String   @unique
  specialisation   String
  working_hours    Json
  slot_duration_min Int     @default(30)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  slots  Slot[]
}

model DoctorLeave {
  id        String   @id @default(cuid())
  doctor_id String
  date      DateTime @db.Date
  reason    String?
  created_at DateTime @default(now())

  doctor User @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  @@unique([doctor_id, date])
}

model Slot {
  id               String     @id @default(cuid())
  doctor_id        String
  start_time       DateTime
  end_time         DateTime
  status           SlotStatus @default(AVAILABLE)
  held_until       DateTime?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  doctor      DoctorProfile @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  appointment Appointment?
}

model Appointment {
  id                     String            @id @default(cuid())
  slot_id                String            @unique
  patient_id             String
  doctor_id              String
  status                 AppointmentStatus @default(CONFIRMED)
  symptoms_text          String?
  ai_pre_summary         Json?
  ai_post_summary        Json?
  doctor_notes           String?
  prescription           Json?
  google_event_id_patient String?
  google_event_id_doctor  String?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  slot                Slot                @relation(fields: [slot_id], references: [id])
  patient             User                @relation("PatientAppointments", fields: [patient_id], references: [id])
  doctor              User                @relation("DoctorAppointments", fields: [doctor_id], references: [id])
  notificationLogs    NotificationLog[]
  medicationReminders MedicationReminder[]
}

model NotificationLog {
  id             String             @id @default(cuid())
  appointment_id String
  type           NotificationType
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  last_error     String?
  metadata       Json?
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
}

model MedicationReminder {
  id             String   @id @default(cuid())
  appointment_id String
  medicine_name  String
  dosage         String?
  frequency      String
  next_send_at   DateTime
  active         Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
}
